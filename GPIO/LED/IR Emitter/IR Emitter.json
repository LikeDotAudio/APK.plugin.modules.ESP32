{
  "IR_Emitter": {
    "type": "OcaBin",
    "description": {
      "En": "📡 Consumer IR blaster for legacy gear that only speaks remote control."
    },
    "implements": null,
    "behavior": {
      "overflow_ns": "auto"
    },
    "blocks": {
      "Identity": {
        "type": "OcaBlock",
        "description": {
          "En": "IR Emitter — identity and binding"
        },
        "layout_columns": 2,
        "fields": {
          "identity": {
            "type": "_Label",
            "domain": {
              "units": null
            },
            "label": {
              "En": "📡 IR Emitter"
            },
            "AES70": "OcaStringSensor"
          },
          "purpose": {
            "type": "_Label",
            "domain": {
              "units": null
            },
            "label": {
              "En": "Consumer IR blaster for legacy gear that only speaks remote control."
            },
            "AES70": "OcaStringSensor"
          },
          "interface": {
            "type": "_ValueBox",
            "id": "IR_Emitter_iface",
            "lbl": "RMT carrier at 38 kHz"
          },
          "topic": {
            "type": "_ValueBox",
            "id": "IR_Emitter_topic",
            "lbl": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/ir_emitter"
          }
        }
      },
      "Control": {
        "type": "OcaBlock",
        "description": {
          "En": "IR Emitter — control surface"
        },
        "layout_columns": 3,
        "fields": {
          "enable": {
            "type": "_SmartToggle",
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/ir_emitter/enable",
            "label": {
              "En": "IR Emitter Enable"
            },
            "geometry": {
              "width": 90,
              "height": 45,
              "font": 14
            },
            "interaction": {
              "options": {
                "ON": {
                  "label": {
                    "active": {
                      "text": {
                        "En": "ENABLED"
                      },
                      "text_size": 12,
                      "text_color": "#cccccc"
                    }
                  },
                  "selected": false
                },
                "OFF": {
                  "label": {
                    "inactive": {
                      "text": {
                        "En": "DISABLED"
                      },
                      "text_size": 12,
                      "text_color": "#cccccc"
                    }
                  }
                }
              },
              "is_sticky": true
            }
          },
          "invoke": {
            "type": "_GuiActuator",
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/ir_emitter/command",
            "label": {
              "active": {
                "text": {
                  "En": "WORKING…"
                }
              },
              "inactive": {
                "text": {
                  "En": "RUN IR EMITTER"
                }
              }
            },
            "layout": {
              "width": 200,
              "height": 45
            }
          },
          "setpoint": {
            "type": "_SmartKnob",
            "label": {
              "En": "IR Emitter Setpoint"
            },
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/ir_emitter/setpoint",
            "geometry": {
              "width": 100,
              "height": 100
            },
            "domain": {
              "primary": {
                "min": 0.0,
                "max": 100.0,
                "unit": "%"
              }
            },
            "cosmetics": {
              "style_flags": {
                "show_grid": true
              }
            }
          }
        }
      },
      "Telemetry": {
        "type": "OcaTable",
        "description": "IR Emitter — live telemetry",
        "topic": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/ir_emitter",
        "headers": [
          "node",
          "key",
          "value",
          "unit",
          "quality",
          "last_seen"
        ],
        "read_cvs": true,
        "write_cvs": false,
        "Add_Row": false,
        "Delete_Row": false,
        "Undo": false,
        "height": 8,
        "Sort": true,
        "data": {},
        "notes": "Consumer IR blaster for legacy gear that only speaks remote control.",
        "layout": {
          "sticky": "ew",
          "padx": 5,
          "pady": 5
        }
      }
    }
  }
}