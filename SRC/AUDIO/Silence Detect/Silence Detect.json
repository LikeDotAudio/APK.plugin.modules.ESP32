{
  "Silence_Detect": {
    "type": "OcaBin",
    "description": {
      "En": "🤫 Dead-air alarm with configurable threshold and hold. The single most requested feature in any plant."
    },
    "implements": null,
    "behavior": {
      "overflow_ns": "auto"
    },
    "blocks": {
      "Identity": {
        "type": "OcaBlock",
        "description": {
          "En": "Silence Detect — identity and binding"
        },
        "layout_columns": 2,
        "fields": {
          "identity": {
            "type": "_Label",
            "domain": {
              "units": null
            },
            "label": {
              "En": "🤫 Silence Detect"
            },
            "AES70": "OcaStringSensor"
          },
          "purpose": {
            "type": "_Label",
            "domain": {
              "units": null
            },
            "label": {
              "En": "Dead-air alarm with configurable threshold and hold. The single most requested feature in any plant."
            },
            "AES70": "OcaStringSensor"
          },
          "interface": {
            "type": "_ValueBox",
            "id": "Silence_Detect_iface",
            "lbl": "Threshold + timer, latching alarm"
          },
          "topic": {
            "type": "_ValueBox",
            "id": "Silence_Detect_topic",
            "lbl": "APK.audio/System/BareMetal/ESP32/{node}/audio/silence_detect"
          }
        }
      },
      "Control": {
        "type": "OcaBlock",
        "description": {
          "En": "Silence Detect — control surface"
        },
        "layout_columns": 3,
        "fields": {
          "enable": {
            "type": "_SmartToggle",
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/audio/silence_detect/enable",
            "label": {
              "En": "Silence Detect Enable"
            },
            "geometry": {
              "width": 90,
              "height": 45,
              "font": 14
            },
            "interaction": {
              "options": {
                "ON": {
                  "label": {
                    "active": {
                      "text": {
                        "En": "ENABLED"
                      },
                      "text_size": 12,
                      "text_color": "#cccccc"
                    }
                  },
                  "selected": false
                },
                "OFF": {
                  "label": {
                    "inactive": {
                      "text": {
                        "En": "DISABLED"
                      },
                      "text_size": 12,
                      "text_color": "#cccccc"
                    }
                  }
                }
              },
              "is_sticky": true
            }
          },
          "invoke": {
            "type": "_GuiActuator",
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/audio/silence_detect/command",
            "label": {
              "active": {
                "text": {
                  "En": "WORKING…"
                }
              },
              "inactive": {
                "text": {
                  "En": "RUN SILENCE DETECT"
                }
              }
            },
            "layout": {
              "width": 200,
              "height": 45
            }
          }
        }
      },
      "Telemetry": {
        "type": "OcaTable",
        "description": "Silence Detect — live telemetry",
        "topic": "APK.audio/System/BareMetal/ESP32/{node}/audio/silence_detect",
        "headers": [
          "node",
          "key",
          "value",
          "unit",
          "quality",
          "last_seen"
        ],
        "read_cvs": true,
        "write_cvs": false,
        "Add_Row": false,
        "Delete_Row": false,
        "Undo": false,
        "height": 8,
        "Sort": true,
        "data": {},
        "notes": "Dead-air alarm with configurable threshold and hold. The single most requested feature in any plant.",
        "layout": {
          "sticky": "ew",
          "padx": 5,
          "pady": 5
        }
      }
    }
  }
}