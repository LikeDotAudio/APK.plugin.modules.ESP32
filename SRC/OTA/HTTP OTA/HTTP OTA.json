{
  "HTTP_OTA": {
    "type": "OcaBin",
    "schema_version": 1,
    "status": "planned",
    "description": {
      "En": "📦 Pull a signed image from the PI host's firmware server and swap partitions."
    },
    "implements": null,
    "behavior": {
      "overflow_ns": "auto"
    },
    "blocks": {
      "Identity": {
        "type": "OcaBlock",
        "description": {
          "En": "HTTP OTA — identity and binding"
        },
        "layout_columns": 2,
        "fields": {
          "identity": {
            "type": "_Label",
            "domain": {
              "units": null
            },
            "label": {
              "En": "📦 HTTP OTA"
            },
            "AES70": "OcaStringSensor"
          },
          "purpose": {
            "type": "_Label",
            "domain": {
              "units": null
            },
            "label": {
              "En": "Pull a signed image from the PI host's firmware server and swap partitions."
            },
            "AES70": "OcaStringSensor"
          },
          "interface": {
            "type": "_ValueBox",
            "id": "HTTP_OTA_iface",
            "lbl": "HTTPS GET, dual OTA partitions"
          },
          "topic": {
            "type": "_ValueBox",
            "id": "HTTP_OTA_topic",
            "lbl": "APK.audio/System/BareMetal/ESP32/{node}/ota/http_ota"
          }
        }
      },
      "Control": {
        "type": "OcaBlock",
        "description": {
          "En": "HTTP OTA — control surface"
        },
        "layout_columns": 3,
        "fields": {
          "enable": {
            "type": "_SmartToggle",
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/ota/http_ota/enable",
            "label": {
              "En": "HTTP OTA Enable"
            },
            "geometry": {
              "width": 90,
              "height": 45,
              "font": 14
            },
            "interaction": {
              "options": {
                "ON": {
                  "label": {
                    "active": {
                      "text": {
                        "En": "ENABLED"
                      },
                      "text_size": 12,
                      "text_color": "#cccccc"
                    }
                  },
                  "selected": false
                },
                "OFF": {
                  "label": {
                    "inactive": {
                      "text": {
                        "En": "DISABLED"
                      },
                      "text_size": 12,
                      "text_color": "#cccccc"
                    }
                  }
                }
              },
              "is_sticky": true
            }
          },
          "invoke": {
            "type": "_GuiActuator",
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/ota/http_ota/command",
            "label": {
              "active": {
                "text": {
                  "En": "WORKING…"
                }
              },
              "inactive": {
                "text": {
                  "En": "RUN HTTP OTA"
                }
              }
            },
            "layout": {
              "width": 200,
              "height": 45
            }
          }
        }
      },
      "Telemetry": {
        "type": "OcaTable",
        "description": "HTTP OTA — live telemetry",
        "topic": "APK.audio/System/BareMetal/ESP32/{node}/ota/http_ota",
        "headers": [
          "node",
          "key",
          "value",
          "unit",
          "quality",
          "last_seen"
        ],
        "read_cvs": true,
        "write_cvs": false,
        "Add_Row": false,
        "Delete_Row": false,
        "Undo": false,
        "height": 8,
        "Sort": true,
        "data": {},
        "notes": "Pull a signed image from the PI host's firmware server and swap partitions.",
        "layout": {
          "sticky": "ew",
          "padx": 5,
          "pady": 5
        }
      }
    }
  }
}