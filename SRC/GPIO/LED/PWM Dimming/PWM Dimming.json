    },
    "implements": null,
    "behavior": {
      "overflow_ns": "auto"
    },
    "blocks": {
      "Identity": {
        "type": "OcaBlock",
        "description": {
          "En": "PWM Dimming — identity and binding"
        },
        "layout_columns": 2,
        "fields": {
          "identity": {
            "type": "_Label",
            "domain": {
              "units": null
            },
            "label": {
              "En": "🔆 PWM Dimming"
            },
            "AES70": "OcaStringSensor"
          },
          "purpose": {
            "type": "_Label",
            "domain": {
              "units": null
            },
            "label": {
              "En": "Smooth 8–13 bit dimming curves for indicator and panel lamps, gamma corrected so fades look linear to the eye."
            },
            "AES70": "OcaStringSensor"
          },
          "interface": {
            "type": "_ValueBox",
            "id": "PWM_Dimming_iface",
            "lbl": "LEDC, 5 kHz default"
          },
          "topic": {
            "type": "_ValueBox",
            "id": "PWM_Dimming_topic",
            "lbl": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/pwm_dimming"
          }
        }
      },
      "Control": {
        "type": "OcaBlock",
        "description": {
          "En": "PWM Dimming — control surface"
        },
        "layout_columns": 3,
        "fields": {
          "enable": {
            "type": "_SmartToggle",
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/pwm_dimming/enable",
            "label": {
              "En": "PWM Dimming Enable"
            },
            "geometry": {
              "width": 90,
              "height": 45,
              "font": 14
            },
            "interaction": {
              "options": {
                "ON": {
                  "label": {
                    "active": {
                      "text": {
                        "En": "ENABLED"
                      },
                      "text_size": 12,
                      "text_color": "#cccccc"
                    }
                  },
                  "selected": false
                },
                "OFF": {
                  "label": {
                    "inactive": {
                      "text": {
                        "En": "DISABLED"
                      },
                      "text_size": 12,
                      "text_color": "#cccccc"
                    }
                  }
                }
              },
              "is_sticky": true
            }
          },
          "invoke": {
            "type": "_GuiActuator",
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/pwm_dimming/command",
            "label": {
              "active": {
                "text": {
                  "En": "WORKING…"
                }
              },
              "inactive": {
                "text": {
                  "En": "RUN PWM DIMMING"
                }
              }
            },
            "layout": {
              "width": 200,
              "height": 45
            }
          },
          "setpoint": {
            "type": "_SmartKnob",
            "label": {
              "En": "PWM Dimming Setpoint"
            },
            "topic": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/pwm_dimming/setpoint",
            "geometry": {
              "width": 100,
              "height": 100
            },
            "domain": {
              "primary": {
                "min": 0.0,
                "max": 100.0,
                "unit": "%"
              }
            },
            "cosmetics": {
              "style_flags": {
                "show_grid": true
              }
            }
          }
        }
      },
      "Telemetry": {
        "type": "OcaTable",
        "description": "PWM Dimming — live telemetry",
        "topic": "APK.audio/System/BareMetal/ESP32/{node}/gpio/led/pwm_dimming",
        "headers": [
          "node",
          "key",
          "value",
          "unit",
          "quality",
          "last_seen"
        ],
        "read_cvs": true,
        "write_cvs": false,
        "Add_Row": false,
        "Delete_Row": false,
        "Undo": false,
        "height": 8,
        "Sort": true,
        "data": {},
        "notes": "Smooth 8–13 bit dimming curves for indicator and panel lamps, gamma corrected so fades look linear to the eye.",
        "layout": {
          "sticky": "ew",
          "padx": 5,
          "pady": 5
        }
      }
